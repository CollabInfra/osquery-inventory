[SERVICE]
    Flush        5
    Daemon       on
    Log_Level    info
    Parsers_File /usr/local/etc/fluent-bit/parsers.conf
    Log_File /usr/local/var/fluent-bit/fluent-bit.log

[INPUT]
    Name              tail
    Path              {{ osquery_log_dir }}/osqueryd.results.log
    Tag               osquery.results
    Parser            json
    DB                /usr/local/var/fluent-bit/osquery-results.db
    Mem_Buf_Limit     5MB
    Skip_Long_Lines   On
    Refresh_Interval  10

[INPUT]
    Name              tail
    Path              {{ osquery_log_dir }}/osqueryd.INFO
    Tag               osquery.info
    Multiline         On
    Parser_Firstline  osquery_log
    DB                /usr/local/var/fluent-bit/osquery-info.db
    Mem_Buf_Limit     5MB
    Skip_Long_Lines   On
    Refresh_Interval  10

[FILTER]
    Name                record_modifier
    Match               osquery.*
    Record              hostname ${HOSTNAME}
    Record              environment {{ opensearch_environment | default('production') }}

[OUTPUT]
    Name                opensearch
    Match               osquery.*
    Host                {{ opensearch_endpoint }}
    Port                {{ opensearch_port | default(443) }}
    Index               {{ opensearch_index_prefix | default('osquery') }}
    Type                _doc
{% if opensearch_use_basic_auth | default(false) %}
    HTTP_User           {{ opensearch_username }}
    HTTP_Passwd         {{ opensearch_password }}
{% else %}
    AWS_Auth            On
    AWS_Region          {{ opensearch_region }}
{% endif %}
    tls                 On
    tls.verify          {{ opensearch_tls_verify | default('On') }}
    Retry_Limit         5
    Suppress_Type_Name  On
    Logstash_Format     On
    Logstash_Prefix     {{ opensearch_index_prefix | default('osquery') }}
    Logstash_DateFormat %Y.%m.%d
    Time_Key            @timestamp

[Unit]
Description=OSQuery Dashboard Web Application
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/osquery-dashboard
Environment="PATH=/opt/osquery-dashboard/venv/bin"
EnvironmentFile=/opt/osquery-dashboard/.env
ExecStart=/opt/osquery-dashboard/venv/bin/gunicorn -w 4 -b 0.0.0.0:5001 --timeout 120 app:app
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

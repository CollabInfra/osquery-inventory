# OpenSearch Configuration
OPENSEARCH_HOST=osquery-logs-prod.us-east-1.opensearch.localhost.localstack.cloud
OPENSEARCH_PORT=4566
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_PREFIX=osquery-

# AWS Configuration (for IAM authentication)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Basic Auth (alternative to IAM)
# OPENSEARCH_USERNAME=admin
# OPENSEARCH_PASSWORD=changeme

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key

# App Configuration
HOST=0.0.0.0
PORT=5001
